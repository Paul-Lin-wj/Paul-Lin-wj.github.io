---
import BaseLayout from '../layouts/BaseLayout.astro';
import Detector from './Detector.astro';
import Card from './Card.astro';
import { dicts, site, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const base = lang === 'zh' ? '/zh' : '';
---

<BaseLayout lang={lang} title={lang === 'zh' ? '主页' : 'Home'} description={t.hero.metaDescription}>
  <header class="hero">
    <div class="hero-bg">
      <div class="glow"></div>
      <div class="glow glow-2"></div>
      <div class="grid"></div>
      <svg class="tracks" width="1200" height="520" viewBox="0 0 1200 520" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="tg-a" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#58a6ff" stop-opacity="0" />
            <stop offset="55%" stop-color="#58a6ff" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#58a6ff" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="tg-b" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#7ee0c8" stop-opacity="0" />
            <stop offset="50%" stop-color="#7ee0c8" stop-opacity="0.45" />
            <stop offset="100%" stop-color="#7ee0c8" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g class="track t1">
          <path d="M -80 470 Q 420 300 760 330 T 1280 240" stroke="url(#tg-a)" stroke-width="1.3" />
          <circle r="2.4" fill="#58a6ff">
            <animateMotion dur="14s" repeatCount="indefinite" path="M -80 470 Q 420 300 760 330 T 1280 240" />
          </circle>
        </g>
        <g class="track t2">
          <path d="M -60 180 C 300 260 640 120 1260 200" stroke="url(#tg-b)" stroke-width="1.1" />
          <circle r="2" fill="#7ee0c8">
            <animateMotion dur="19s" begin="-6s" repeatCount="indefinite" path="M -60 180 C 300 260 640 120 1260 200" />
          </circle>
        </g>
        <g class="track t3">
          <path d="M 200 560 Q 480 380 700 420 T 1250 330" stroke="url(#tg-a)" stroke-width="1" opacity="0.7" />
          <circle r="1.8" fill="#58a6ff" opacity="0.8">
            <animateMotion dur="23s" begin="-12s" repeatCount="indefinite" path="M 200 560 Q 480 380 700 420 T 1250 330" />
          </circle>
        </g>
      </svg>
      <Detector size={340} />
    </div>

    <div class="wrap hero-inner">
      <p class="kicker">{t.hero.kicker}</p>

      <h1>
        <span class="name-primary">{t.hero.namePrimary}</span>
        {t.hero.nameSecondary && <span class="name-secondary">{t.hero.nameSecondary}</span>}
      </h1>

      <div class="pills">
        <a class="pill" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m2 7 10 6 10-6" />
          </svg>
          {t.hero.email}
        </a>
        <a class="pill" href={site.github} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3" />
          </svg>
          {t.hero.github}
        </a>
      </div>

      <div class="cta">
        <a href={`${base}/about`}>{t.hero.ctaAbout} <span class="arrow">→</span></a>
        <a href={`${base}/projects`}>{t.hero.ctaProjects} <span class="arrow">→</span></a>
      </div>
    </div>
  </header>

  <section class="section" id="projects" data-num="01">
    <div class="wrap">
      <p class="sec-kicker">{t.projects.kicker}</p>
      <h2>{t.projects.title}</h2>
      <p class="sec-lede">{t.projects.lede}</p>
      <div class="cards two">
        {t.projects.cards.map((c) => <Card {...c} />)}
      </div>
      <div class="cta" style="margin-top:26px">
        <a href={`${base}/projects`}>{t.projects.more} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="publication" data-num="02">
    <div class="wrap">
      <p class="sec-kicker">{t.publication.kicker}</p>
      <h2>{t.publication.title}</h2>
      <div class="cards" style="margin-top:26px">
        <Card {...t.publication.card} />
      </div>
    </div>
  </section>
</BaseLayout>
